# ---- Model plane: Ollama only, no MODEL_PROVIDER dispatch ----
# Both required — no baked default. Ollama's own real default (num_ctx=2048)
# would silently misconfigure a large-context model instead of failing loudly.
OLLAMA_MODEL=                     # e.g. gpt-oss:20b — must support tool calling
                                   # (`ollama show <model>` lists `tools`)
OLLAMA_CONTEXT_WINDOW=            # e.g. 32768 — the model's real context length
OLLAMA_BASE_URL=http://localhost:11434

MODEL_TIMEOUT=600

# ---- File store (docs/adr/0002-dedicated-volume-for-file-store.md) ----
# Local disk directory backing the upload/download HTTP app (`/files`) and
# `output-writer`'s `store_output_bytes`. A relative value resolves against
# this process's cwd, captured once at import (agent/config.py) — fine for
# local dev, run from this repo root. docker-compose.yml overrides this to
# the absolute /app/data unconditionally, because inside that container the
# cwd is /app/aegra-host, not /app: a relative value there would silently
# miss the dedicated volume entirely.
FILE_STORE_DIR=./data

# ---- Web search (docs/adr/0007-web-search-per-run-gate-via-middleware.md) ----
# Tavily only — no SEARCH_PROVIDER dispatch. Per-run availability is a
# `configurable.enable_web_search` flag the client sets on each run (the
# agent-chat-ui composer's "Web Search" toggle), not a deployment-wide
# setting; this key only controls whether the `web-search` subagent's own
# `web_search` tool can actually reach Tavily once a run has the toggle on.
# Leaving it unset makes `web_search` reply that it isn't configured, rather
# than silently returning no results.
TAVILY_API_KEY=

# ---- Human in the loop ----
# Carried over from agent-runtime with an empty gate set: no tool in this
# design is approval-gated, so this is inert but present — setting it to
# true installs HumanInTheLoopMiddleware, but nothing is configured to gate,
# so a run never actually pauses.
REQUIRE_APPROVAL=false

# ---- Durable thread state: THE CHECKPOINTER ----
# Postgres holds run state, so a container restart doesn't lose an
# in-progress conversation. Unset it and the runtime falls back to
# in-memory state (agent.runner, scripts/verify_stack.py only — a served
# run under `aegra serve` always persists through aegra's own saver).
#
# Local docker-compose stack:
DATABASE_URL=postgresql://aegra:aegra@localhost:5432/aegra
